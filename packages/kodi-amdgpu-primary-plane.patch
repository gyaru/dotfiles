+  drmVersionPtr driver = drmGetVersion(m_fd);
+  const bool needsPrimary = driver && std::strcmp(driver->name, "amdgpu") == 0;
+  if (driver)
+    drmFreeVersion(driver);
+
+  if (needsPrimary)
+  {
+    for (size_t i = 0; i < m_crtcs.size(); ++i)
+    {
+      if (!(m_encoder->GetPossibleCrtcs() & (1 << i)))
+        continue;
+
+      for (const auto& plane : m_planes)
+      {
+        if (!(plane->GetPossibleCrtcs() & (1 << i)) || !plane->IsPrimary() ||
+            !(plane->SupportsFormat(DRM_FORMAT_XRGB2101010) ||
+              plane->SupportsFormat(DRM_FORMAT_XRGB8888)))
+          continue;
+
+        m_crtc = m_crtcs[i].get();
+        m_gui_plane = plane.get();
+        m_video_plane = nullptr;
+        CLog::Log(LOGINFO, "CDRMUtils::FindPlanes - using AMD primary plane {} on crtc {}",
+                  m_gui_plane->GetPlaneId(), m_crtc->GetCrtcId());
+        return true;
+      }
+    }
+
+    CLog::Log(LOGERROR, "CDRMUtils::FindPlanes - no compatible AMD primary plane found");
+    return false;
+  }
