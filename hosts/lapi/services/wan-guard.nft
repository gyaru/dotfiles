destroy table inet lapi_wan

table inet lapi_wan {
    chain client_to_host {
        ct state invalid counter drop
        ct direction reply ct state established,related counter accept
        tcp dport { 22, 445 } counter accept
        udp sport 68 udp dport 67 counter accept
        udp dport 41641 counter accept
        iifname "br-lan" ip daddr 192.168.1.240 tcp dport 53 counter accept
        iifname "br-lan" ip daddr 192.168.1.240 udp dport 53 counter accept
        iifname "virbr0" ip daddr 192.168.122.1 tcp dport 53 counter accept
        iifname "virbr0" ip daddr 192.168.122.1 udp dport 53 counter accept
        ip6 hoplimit 255 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } counter accept
        counter drop
    }

    chain client_ingress {
        type filter hook prerouting priority -190; policy accept;
        iifname { "eno1", "br-lan", "virbr0" } ip saddr 127.0.0.0/8 counter drop
        iifname { "eno1", "br-lan", "virbr0" } ip daddr 127.0.0.0/8 counter drop
        iifname { "eno1", "br-lan", "virbr0" } ip6 saddr ::1 counter drop
        iifname { "eno1", "br-lan", "virbr0" } ip6 daddr ::1 counter drop
        iifname { "br-lan", "virbr0" } fib daddr type local jump client_to_host
    }

    chain client_input {
        type filter hook input priority 10; policy accept;
        iifname { "br-lan", "virbr0" } jump client_to_host
    }

    chain ingress {
        type filter hook prerouting priority -190; policy accept;
        iifname != "eno1" return

        meta nfproto ipv6 counter drop
        ct state invalid counter drop
        ct state established,related counter accept

        udp sport 67 udp dport 68 counter accept
        counter drop
    }

    chain forward {
        type filter hook forward priority 10; policy accept;

        iifname "br-lan" oifname "br-lan" counter accept
        iifname "virbr0" oifname "virbr0" counter accept
        iifname { "br-lan", "virbr0" } ct direction reply ct state established,related counter accept
        iifname { "br-lan", "virbr0" } oifname != "eno1" counter drop

        iifname "eno1" ct state established,related counter accept
        iifname "eno1" counter drop

        oifname "eno1" meta nfproto ipv6 counter drop
        oifname "eno1" ct state invalid counter drop
        oifname "eno1" ip saddr { 192.168.1.0/24, 10.42.0.0/16, 192.168.122.0/24 } counter accept
        oifname "eno1" counter drop
    }

    chain output {
        type filter hook output priority 10; policy accept;
        oifname "eno1" meta nfproto ipv6 counter drop
    }
}
